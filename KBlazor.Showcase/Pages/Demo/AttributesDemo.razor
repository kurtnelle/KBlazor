@* KBlazor.Showcase/Pages/Demo/AttributesDemo.razor *@
@page "/demo/attributes"

<PageTitle>Attributes — KBlazor</PageTitle>

<div class="demo-layout">
    <NavMenu />
    <div class="demo-body">
        <div class="demo-header">
            <h2>Attributes</h2>
            <p class="demo-sub">KBlazor attributes decorate model properties to control how they appear in FlexTable and BasicEdit.</p>
        </div>
        <div class="demo-content">
            <div class="attr-grid">
                @foreach (var attr in _attrs)
                {
                    <div class="attr-card">
                        <div class="attr-name">@attr.Name</div>
                        <p class="attr-desc">@attr.Description</p>
                        <pre class="attr-code"><code>@attr.Example</code></pre>
                        <div class="attr-applies">
                            @foreach (var tag in attr.AppliesTo)
                            {
                                <span class="applies-tag">@tag</span>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<style>
    .attr-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(360px, 1fr)); gap: 16px; }
    .attr-card {
        background: var(--bg-card); border: 1px solid var(--border); border-radius: 14px;
        padding: 22px; display: flex; flex-direction: column; gap: 12px;
        transition: all 0.2s ease;
    }
    .attr-card:hover {
        border-color: rgba(108,92,231,0.25);
        box-shadow: 0 4px 20px rgba(0,0,0,0.2), 0 0 0 1px rgba(108,92,231,0.08);
        transform: translateY(-2px);
    }
    .attr-name { font-size: 15px; font-weight: 700; color: var(--accent); font-family: var(--mono); }
    .attr-desc { margin: 0; font-size: 13px; color: var(--text-muted); line-height: 1.6; }
    .attr-code {
        margin: 0; font-size: 12px; background: #0A0918; padding: 14px 16px;
        border-radius: 8px; border: 1px solid var(--border); line-height: 1.7;
    }
    .attr-code code { background: none; padding: 0; font-family: var(--mono); color: #C8C2F0; }
    .attr-applies { display: flex; gap: 6px; flex-wrap: wrap; }
    .applies-tag {
        font-size: 10px; font-weight: 600;
        background: rgba(108,92,231,0.1); color: var(--accent);
        padding: 3px 10px; border-radius: 999px;
        border: 1px solid rgba(108,92,231,0.15);
        letter-spacing: 0.3px;
    }
</style>

@code {
    private record AttrInfo(string Name, string Description, string Example, string[] AppliesTo);

    private static readonly AttrInfo[] _attrs = new[]
    {
        new AttrInfo("[AllowInlineEdit]",
            "Marks a property editable directly within the FlexTable row. Use with the InlineEditor parameter.",
            "[Display(Name = \"Urgent\")]\n[AllowInlineEdit]\npublic bool IsUrgent { get; set; }",
            new[] { "FlexTable" }),

        new AttrInfo("[AlsoInclude]",
            "Applied to an entity class. When FlexTable or BasicEdit build a lookup list for that entity, the named navigation property is eager-loaded via IEntityLookupProvider.GetEntitiesWithInclude.",
            "[AlsoInclude(Name = \"Lines\")]\npublic class Order : IKBusinessEntity\n{\n    public virtual ICollection<OrderLine> Lines { get; set; }\n}",
            new[] { "FlexTable", "BasicEdit" }),

        new AttrInfo("[AutoComplete]",
            "On an entity-typed navigation property: BasicEdit renders a searchable MudAutocomplete instead of a dropdown, and the FlexTable column filter becomes an autocomplete with chips. No effect on scalar (Guid?) foreign keys.",
            "[Display(Name = \"Customer\")]\n[AutoComplete]\npublic virtual Customer? Customer { get; set; }",
            new[] { "FlexTable", "BasicEdit" }),

        new AttrInfo("[CasscadeLookup]",
            "Declared only — intended for a dependent dropdown filtered by another property's value. Not consumed by any component yet.",
            "[Display(Name = \"Sub-Category\")]\n[CasscadeLookup(AdditionalProperties = \"CategoryId\")]\npublic Guid? SubCategoryId { get; set; }",
            new[] { "Declared only" }),

        new AttrInfo("[DisplayNoWrap]",
            "Declared only — FlexTable cells already render nowrap with ellipsis, and the attribute is not read.",
            "[Display(Name = \"Amount\")]\n[DisplayNoWrap]\npublic decimal Amount { get; set; }",
            new[] { "Declared only" }),

        new AttrInfo("[EnableTime]",
            "Declared only — BasicEdit reads it, but the date picker currently stays date-only.",
            "[Display(Name = \"Order Date\")]\n[EnableTime]\npublic DateTime OrderDate { get; set; }",
            new[] { "Declared only" }),

        new AttrInfo("[LinkOnField]",
            "Declared only — FlexTable reads it, but the value is still rendered as plain text.",
            "[Display(Name = \"Reference\")]\n[LinkOnField]\npublic string Reference { get; set; }",
            new[] { "Declared only" }),

        new AttrInfo("[MemoDisplay]",
            "Renders the field in BasicEdit as an Edit button that opens a dialog with a multiline textarea.",
            "[Display(Name = \"Notes\")]\n[MemoDisplay]\npublic string Notes { get; set; }",
            new[] { "BasicEdit" }),

        new AttrInfo("[ReadOnlyOnEdit]",
            "Makes the field read-only when editing an existing entity (IsNew == false).",
            "[Display(Name = \"Order #\")]\n[ReadOnlyOnEdit]\npublic string Name { get; set; }",
            new[] { "BasicEdit" }),

        new AttrInfo("[SortAndFilterOn]",
            "Gives SortAndFilterEngine dot-paths for an entity column: FilterPath (the FK id) makes it filterable via the name-search checkbox filter, SortPath makes it sortable by a scalar. Requires routing SortFilter through ApplyFilter/ApplySort. The legacy Member property is ignored.",
            "[Display(Name = \"Customer\")]\n[SortAndFilterOn(FilterPath = \"CustomerId\", SortPath = \"Customer.Name\")]\npublic virtual Customer? Customer { get; set; }",
            new[] { "FlexTable" }),

        new AttrInfo("[ToolTipOnField]",
            "Declared only — intended to show a tooltip sourced from another property. Not consumed by any component yet.",
            "[Display(Name = \"Name\")]\n[ToolTipOnField(PropertyName = \"Description\")]\npublic string Name { get; set; }",
            new[] { "Declared only" }),
    };
}
