<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS hosting configuration for the showcase (kblazor.com).
  Shipped with the project so every deploy carries it, whether the pipeline
  copies publish output or build output. The Web SDK uses this file as the
  publish template; do not remove the aspNetCore handler.
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet" arguments=".\KBlazor.Showcase.dll" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="inprocess" />
    </system.webServer>
  </location>
</configuration>
